# Langfuse tracing is enabled only when both keys are present.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PORT=3001
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_POSTGRES_PASSWORD=change-me-langfuse-db
LANGFUSE_SALT=change-me-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-password
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_INIT_USER_EMAIL=admin@agentforge.local
LANGFUSE_INIT_USER_PASSWORD=change-me-admin-password
OPEN_AI_API_KEY=your-secret-openai-api-key